{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Elin mod Plugin.json schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "disableDebugPublish",
    "log"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "スキーマのURI"
    },
    "disableDebugPublish": {
      "type": "boolean",
      "description": "デバッグ時に公開を無効にするかどうか"
    },
    "log": {
      "type": "string",
      "description": "デバッグ時ログ出力パス"
    }
  }
}
